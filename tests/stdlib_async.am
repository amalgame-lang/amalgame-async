// Stdlib test: Amalgame.Async — Fiber + Channel + Scheduler.
// Self-contained, no external service. Exercises:
//   - FiberSpawn + SchedulerRun pumps to completion
//   - Yield round-robin ordering
//   - Sleep ordering (earlier wake-time runs first)
//   - Channel Send/Receive parks/wakes the right fiber
//   - Channel Close drains + sentinels
//   - SchedulerRunUntil deadline
//   - SchedulerPending count

namespace Tests

import Amalgame.Async

public class Counter {
    public Value: int

    public Counter(int v) {
        this.Value = v
    }
}

public class Program {
    public static void Main(string[] args) {

        // ── Spawn 3 fibers, each increments a shared counter ─
        let c = new Counter(0)
        let bump = (_x: int) => {
            // single yield to demonstrate cooperative scheduling
            c.Value = c.Value + 1
            Async.FiberYield()
            c.Value = c.Value + 10
            return 0
        }
        Async.FiberSpawn(bump, 0)
        Async.FiberSpawn(bump, 0)
        Async.FiberSpawn(bump, 0)
        Async.SchedulerRun()
        // each fiber adds 1 then 10 — total 33
        if (c.Value == 33) {
            Console.WriteLine("[PASS] 3 fibers run to completion")
        } else {
            Console.WriteLine("[FAIL] counter = " + String_FromInt(c.Value))
        }

        // ── Round-robin yield ordering ───────────────────────
        // Three fibers writing their id into a shared channel
        // between yields. Order should be 1,2,3,1,2,3,...
        let orderCh = Async.ChannelNew(32)
        let stamp = (id: int) => {
            var i: int = 0
            while (i < 3) {
                Async.ChannelSend(orderCh, id)
                Async.FiberYield()
                i = i + 1
            }
            return 0
        }
        Async.FiberSpawn(stamp, 1)
        Async.FiberSpawn(stamp, 2)
        Async.FiberSpawn(stamp, 3)
        Async.SchedulerRun()
        Async.ChannelClose(orderCh)
        // Expect: 1, 2, 3, 1, 2, 3, 1, 2, 3
        var seq: int = 0
        var slot: int = 0
        while (slot < 9) {
            let v: int = Async.ChannelTryReceive(orderCh)
            seq = seq * 10 + v
            slot = slot + 1
            if (seq > 999999999) { break }  // overflow guard
        }
        // 123123123
        if (seq == 123123123) {
            Console.WriteLine("[PASS] round-robin yield ordering")
        } else {
            Console.WriteLine("[FAIL] seq = " + String_FromInt(seq))
        }

        // ── Sleep ordering: earlier wake_at runs first ───────
        let sleepCh = Async.ChannelNew(4)
        let sleepy = (id: int) => {
            // id 1 sleeps 40ms, id 2 sleeps 20ms, id 3 sleeps 80ms
            if (id == 1) { Async.FiberSleep(40) }
            if (id == 2) { Async.FiberSleep(20) }
            if (id == 3) { Async.FiberSleep(80) }
            Async.ChannelSend(sleepCh, id)
            return 0
        }
        Async.FiberSpawn(sleepy, 1)
        Async.FiberSpawn(sleepy, 2)
        Async.FiberSpawn(sleepy, 3)
        Async.SchedulerRun()
        Async.ChannelClose(sleepCh)
        let s1: int = Async.ChannelReceive(sleepCh)
        let s2: int = Async.ChannelReceive(sleepCh)
        let s3: int = Async.ChannelReceive(sleepCh)
        // Expected order: 2 (20ms), 1 (40ms), 3 (80ms)
        if (s1 == 2 && s2 == 1 && s3 == 3) {
            Console.WriteLine("[PASS] sleep wake-time ordering")
        } else {
            Console.WriteLine("[FAIL] sleep order: " + String_FromInt(s1)
                + "/" + String_FromInt(s2) + "/" + String_FromInt(s3))
        }

        // ── Channel parking: send blocks, recv unparks ───────
        // Tiny capacity-1 channel. Producer wants to send 4
        // values; consumer pulls them one at a time with yields
        // in between, exercising the parking + waking path.
        let smallCh = Async.ChannelNew(1)
        let prodC = new Counter(0)
        let producer = (_x: int) => {
            var i: int = 0
            while (i < 4) {
                Async.ChannelSend(smallCh, 100 + i)
                prodC.Value = prodC.Value + 1
                i = i + 1
            }
            Async.ChannelClose(smallCh)
            return 0
        }
        let consC = new Counter(0)
        let consSum = new Counter(0)
        let consumer = (_x: int) => {
            while (true) {
                let v: int = Async.ChannelReceive(smallCh)
                if (v == 0 && Async.ChannelIsClosed(smallCh)) { break }
                consSum.Value = consSum.Value + v
                consC.Value = consC.Value + 1
                Async.FiberYield()
            }
            return 0
        }
        Async.FiberSpawn(producer, 0)
        Async.FiberSpawn(consumer, 0)
        Async.SchedulerRun()
        // values: 100 + 101 + 102 + 103 = 406
        if (prodC.Value == 4 && consC.Value == 4 && consSum.Value == 406) {
            Console.WriteLine("[PASS] channel parking producer-consumer")
        } else {
            Console.WriteLine("[FAIL] prod=" + String_FromInt(prodC.Value)
                + " cons=" + String_FromInt(consC.Value)
                + " sum=" + String_FromInt(consSum.Value))
        }

        // ── SchedulerRunUntil deadline ───────────────────────
        // Spawn one fiber that sleeps 500ms. Run with a 30ms
        // budget — fiber doesn't finish, but RunUntil returns.
        let longSleep = (_x: int) => {
            Async.FiberSleep(500)
            return 0
        }
        Async.FiberSpawn(longSleep, 0)
        Async.SchedulerRunUntil(30)
        let pending: int = Async.SchedulerPending()
        if (pending == 1) {
            Console.WriteLine("[PASS] RunUntil deadline + Pending count")
        } else {
            Console.WriteLine("[FAIL] pending = " + String_FromInt(pending))
        }
        // Drain the leftover fiber so it doesn't interfere with
        // subsequent tests' scheduler state.
        Async.SchedulerRun()

        // ── FiberCurrentId behaviour ─────────────────────────
        let idsCh = Async.ChannelNew(4)
        let recorder = (_x: int) => {
            Async.ChannelSend(idsCh, Async.FiberCurrentId())
            return 0
        }
        Async.FiberSpawn(recorder, 0)
        Async.FiberSpawn(recorder, 0)
        Async.SchedulerRun()
        Async.ChannelClose(idsCh)
        let id1: int = Async.ChannelReceive(idsCh)
        let id2: int = Async.ChannelReceive(idsCh)
        // Outside any fiber, CurrentId() should return 0
        let idMain: int = Async.FiberCurrentId()
        if (id1 > 0 && id2 > id1 && idMain == 0) {
            Console.WriteLine("[PASS] FiberCurrentId distinct + 0 outside")
        } else {
            Console.WriteLine("[FAIL] ids id1=" + String_FromInt(id1)
                + " id2=" + String_FromInt(id2)
                + " main=" + String_FromInt(idMain))
        }

        // ── Channel: closed-and-empty Receive returns 0 ──────
        let drainCh = Async.ChannelNew(2)
        Async.ChannelSend(drainCh, 7)
        Async.ChannelSend(drainCh, 8)
        Async.ChannelClose(drainCh)
        let d1: int = Async.ChannelReceive(drainCh)
        let d2: int = Async.ChannelReceive(drainCh)
        let d3: int = Async.ChannelReceive(drainCh)
        if (d1 == 7 && d2 == 8 && d3 == 0 && Async.ChannelIsClosed(drainCh)) {
            Console.WriteLine("[PASS] channel drain-then-sentinel after Close")
        } else {
            Console.WriteLine("[FAIL] drain " + String_FromInt(d1)
                + "/" + String_FromInt(d2) + "/" + String_FromInt(d3))
        }

        // ═══════════════════════════════════════════════════════
        // v0.2 — I/O parking via epoll
        // ═══════════════════════════════════════════════════════

        // ── Open a pipe via inline C (pipe(), close(), fcntl) ─
        var rfd: int = -1
        var wfd: int = -1
        var pipeOk: int = 0
        @c {
            int _pfds[2];
            if (pipe(_pfds) == 0) {
                rfd = _pfds[0];
                wfd = _pfds[1];
                pipeOk = 1;
            }
        }

        if (pipeOk != 1) {
            Console.WriteLine("[FAIL] pipe() syscall failed")
        } else {
            // ── MakeNonBlocking flips O_NONBLOCK on an fd ────
            let okNb: bool = Async.MakeNonBlocking(rfd)
            var nbFlag: int = 0
            @c {
                int _fl = fcntl((int) rfd, F_GETFL, 0);
                if (_fl >= 0 && (_fl & O_NONBLOCK)) nbFlag = 1;
            }
            if (okNb && nbFlag == 1) {
                Console.WriteLine("[PASS] MakeNonBlocking sets O_NONBLOCK")
            } else {
                Console.WriteLine("[FAIL] MakeNonBlocking ok=" + String_FromInt(okNb)
                    + " flag=" + String_FromInt(nbFlag))
            }

            // ── WaitFdReadable wakes when a byte arrives ─────
            // Two fibers:
            //   - reader: WaitFdReadable on pipe[0], then read 1 byte
            //   - writer: brief Sleep, then write 1 byte to pipe[1]
            // If epoll integration works, the reader fiber parks
            // until the writer's byte arrives, then both finish.
            let readBox = new Counter(0)
            let readerReady = new Counter(0)
            // The fd is passed via FiberSpawn's arg (not via
            // closure capture) because @c {} blocks are opaque
            // to the resolver — referencing wfd/rfd only in C
            // code wouldn't add them to the closure's env.
            let reader = (fd: int) => {
                let ok: bool = Async.WaitFdReadable(fd, 2000)
                if (ok) {
                    readerReady.Value = 1
                    var byteIn: int = -1
                    @c {
                        unsigned char _c = 0;
                        ssize_t _n = read((int) fd, &_c, 1);
                        byteIn = (_n > 0) ? (i64) _c : (i64) -1;
                    }
                    readBox.Value = byteIn
                }
                return 0
            }
            let writer = (fd: int) => {
                Async.FiberSleep(20)
                @c {
                    unsigned char _c = 42;
                    write((int) fd, &_c, 1);
                }
                return 0
            }
            Async.FiberSpawn(reader, rfd)
            Async.FiberSpawn(writer, wfd)
            Async.SchedulerRun()
            if (readerReady.Value == 1 && readBox.Value == 42) {
                Console.WriteLine("[PASS] WaitFdReadable wakes on byte arrival")
            } else {
                Console.WriteLine("[FAIL] WaitFdReadable ready="
                    + String_FromInt(readerReady.Value)
                    + " byte=" + String_FromInt(readBox.Value))
            }

            // ── WaitFdReadable timeout returns false ─────────
            // Same fd, but no writer this time. Wait 50ms and
            // assert the call returned without a byte.
            let timeoutBox = new Counter(0)
            let waiter = (fd: int) => {
                let ok: bool = Async.WaitFdReadable(fd, 50)
                if (!ok) { timeoutBox.Value = 1 }
                return 0
            }
            Async.FiberSpawn(waiter, rfd)
            Async.SchedulerRun()
            if (timeoutBox.Value == 1) {
                Console.WriteLine("[PASS] WaitFdReadable timeout returns false")
            } else {
                Console.WriteLine("[FAIL] WaitFdReadable timeout box="
                    + String_FromInt(timeoutBox.Value))
            }

            @c {
                close((int) rfd);
                close((int) wfd);
            }
        }

        // ═══════════════════════════════════════════════════════
        // v0.2.2 — cooperative cancellation
        // ═══════════════════════════════════════════════════════

        // ── Cancel-while-sleeping: spawn a fiber that sleeps for
        // a long time, cancel it from another fiber, observe that
        // the sleep returns promptly and IsCancelled is true. ──
        let cancelBox = new Counter(0)
        let cancelObs = new Counter(0)
        let longSleeper = (_x: int) => {
            Async.FiberSleep(60000)   // 60s — would block the test if cancel doesn't wake us
            if (Async.IsCancelled()) {
                cancelObs.Value = 1
            }
            cancelBox.Value = 1
            return 0
        }
        let sleeper: AmalgameFiber = Async.FiberSpawn(longSleeper, 0)
        let killer = (_x: int) => {
            Async.FiberSleep(50)
            Async.FiberCancel(sleeper)
            return 0
        }
        Async.FiberSpawn(killer, 0)
        // RunUntil rather than Run: bound the test even if the
        // cancellation is broken (avoids a 60s wait).
        Async.SchedulerRunUntil(2000)
        if (cancelBox.Value == 1 && cancelObs.Value == 1) {
            Console.WriteLine("[PASS] FiberCancel wakes a sleeping fiber")
        } else {
            Console.WriteLine("[FAIL] cancel-sleep box="
                + String_FromInt(cancelBox.Value)
                + " obs=" + String_FromInt(cancelObs.Value))
        }

        // ── Cancel-while-channel-recv: receiver parks on empty
        // channel forever; canceller wakes it. ChannelReceive
        // returns 0 (sentinel) and IsCancelled is true. ──
        let recvCh = Async.ChannelNew(1)
        let recvBox = new Counter(0)
        let recvObs = new Counter(0)
        let recvSpawned = new Counter(0)
        var recvFiberId: int = 0
        let parkRecv = (_x: int) => {
            recvSpawned.Value = 1
            let v: int = Async.ChannelReceive(recvCh)
            recvBox.Value = v + 1   // +1 so 0-on-cancel maps to 1
            if (Async.IsCancelled()) { recvObs.Value = 1 }
            return 0
        }
        let recvFiber: AmalgameFiber = Async.FiberSpawn(parkRecv, 0)
        let recvKiller = (_x: int) => {
            Async.FiberSleep(50)
            Async.FiberCancel(recvFiber)
            return 0
        }
        Async.FiberSpawn(recvKiller, 0)
        Async.SchedulerRunUntil(2000)
        if (recvBox.Value == 1 && recvObs.Value == 1) {
            Console.WriteLine("[PASS] FiberCancel wakes a channel-parked fiber")
        } else {
            Console.WriteLine("[FAIL] cancel-recv box="
                + String_FromInt(recvBox.Value)
                + " obs=" + String_FromInt(recvObs.Value))
        }

        // ── Pre-cancelled fiber: cancelling before SchedulerRun
        // pumps it should cause Sleep / WaitFd / ChannelReceive
        // to early-out, not park. We measure the runtime here. ──
        let preBox = new Counter(0)
        let preBody = (_x: int) => {
            Async.FiberSleep(10000)   // would block 10s if it parked
            preBox.Value = 1
            return 0
        }
        let preTarget: AmalgameFiber = Async.FiberSpawn(preBody, 0)
        Async.FiberCancel(preTarget)   // before any pump
        Async.SchedulerRunUntil(500)
        if (preBox.Value == 1) {
            Console.WriteLine("[PASS] pre-cancelled fiber early-outs at every yield")
        } else {
            Console.WriteLine("[FAIL] pre-cancel box=" + String_FromInt(preBox.Value))
        }

        // ═══════════════════════════════════════════════════════
        // v0.2.3 — WithTimeout
        // ═══════════════════════════════════════════════════════

        // Fast worker (50 ms) under a 1 s budget → returns true,
        // body actually ran.
        let fastBox = new Counter(0)
        let fastBody = (_x: int) => {
            Async.FiberSleep(50)
            fastBox.Value = 42
            return 0
        }
        // WithTimeout must itself be called from inside a fiber (it
        // ChannelReceive's on its done channel). Wrap in a runner.
        let fastResult = new Counter(-1)
        let fastRunner = (_x: int) => {
            let done: bool = Async.WithTimeout(fastBody, 0, 1000)
            fastResult.Value = done ? 1 : 0
            return 0
        }
        Async.FiberSpawn(fastRunner, 0)
        Async.SchedulerRunUntil(3000)
        if (fastResult.Value == 1 && fastBox.Value == 42) {
            Console.WriteLine("[PASS] WithTimeout returns true when worker finishes early")
        } else {
            Console.WriteLine("[FAIL] WithTimeout fast: done="
                + String_FromInt(fastResult.Value)
                + " box=" + String_FromInt(fastBox.Value))
        }

        // Slow worker (5 s) under a 100 ms budget → returns false,
        // worker gets cancelled mid-sleep, completion side-effect
        // never observed by the caller.
        let slowBox = new Counter(0)
        let slowBody = (_x: int) => {
            Async.FiberSleep(5000)
            slowBox.Value = 99   // shouldn't observe this
            return 0
        }
        let slowResult = new Counter(-1)
        let slowRunner = (_x: int) => {
            let done: bool = Async.WithTimeout(slowBody, 0, 100)
            slowResult.Value = done ? 1 : 0
            return 0
        }
        Async.FiberSpawn(slowRunner, 0)
        Async.SchedulerRunUntil(2000)
        if (slowResult.Value == 0) {
            Console.WriteLine("[PASS] WithTimeout returns false on deadline")
        } else {
            Console.WriteLine("[FAIL] WithTimeout slow result="
                + String_FromInt(slowResult.Value))
        }

        // ═══════════════════════════════════════════════════════
        // v0.3 — Async.Select (first-of-N channel receive)
        // ═══════════════════════════════════════════════════════

        // ── A. SelectReceive parks then wakes on the ready chan ─
        // Selector parks on [a, b] (both empty). A feeder sleeps
        // first (so the selector is parked), then sends on b only.
        // Selector must wake, report index 1, value 77.
        let selA = Async.ChannelNew(2)
        let selB = Async.ChannelNew(2)
        let selAIdx = new Counter(-9)
        let selAVal = new Counter(-9)
        let selector = (_x: int) => {
            let chs = [selA, selB]
            let i: int = Async.SelectReceive(chs)
            selAIdx.Value = i
            selAVal.Value = Async.SelectValue()
            return 0
        }
        let feeder = (_x: int) => {
            Async.FiberSleep(10)        // let the selector park first
            Async.ChannelSend(selB, 77)
            return 0
        }
        Async.FiberSpawn(selector, 0)
        Async.FiberSpawn(feeder, 0)
        Async.SchedulerRun()
        if (selAIdx.Value == 1 && selAVal.Value == 77) {
            Console.WriteLine("[PASS] SelectReceive parks then wakes on ready channel")
        } else {
            Console.WriteLine("[FAIL] select wake idx=" + String_FromInt(selAIdx.Value)
                + " val=" + String_FromInt(selAVal.Value))
        }

        // ── B. SelectReceive drains two producers (re-scan) ─────
        // Two producers each push 3 values (with yields). One
        // consumer selects over both, summing 6 values total. The
        // park / wake / re-scan loop must lose nothing.
        let selP = Async.ChannelNew(8)
        let selQ = Async.ChannelNew(8)
        let selSum = new Counter(0)
        let selCnt = new Counter(0)
        let drainer = (_x: int) => {
            let chs = [selP, selQ]
            var got: int = 0
            while (got < 6) {
                let i: int = Async.SelectReceive(chs)
                if (i < 0) { break }
                selSum.Value = selSum.Value + Async.SelectValue()
                selCnt.Value = selCnt.Value + 1
                got = got + 1
            }
            return 0
        }
        let prodP = (_x: int) => {
            var i: int = 0
            while (i < 3) { Async.ChannelSend(selP, 10); Async.FiberYield(); i = i + 1 }
            return 0
        }
        let prodQ = (_x: int) => {
            var i: int = 0
            while (i < 3) { Async.ChannelSend(selQ, 100); Async.FiberYield(); i = i + 1 }
            return 0
        }
        Async.FiberSpawn(drainer, 0)
        Async.FiberSpawn(prodP, 0)
        Async.FiberSpawn(prodQ, 0)
        Async.SchedulerRun()
        // 3*10 + 3*100 = 330 across 6 receives
        if (selSum.Value == 330 && selCnt.Value == 6) {
            Console.WriteLine("[PASS] SelectReceive drains two producers without loss")
        } else {
            Console.WriteLine("[FAIL] select drain sum=" + String_FromInt(selSum.Value)
                + " cnt=" + String_FromInt(selCnt.Value))
        }

        // ── C. SelectReceive reports a closed+empty channel ─────
        // openCh is empty+open (never ready); closedCh is closed.
        // Only closedCh qualifies → index 1, sentinel value 0.
        let openCh = Async.ChannelNew(1)
        let closedCh = Async.ChannelNew(1)
        Async.ChannelClose(closedCh)
        let closedIdx = new Counter(-9)
        let closedVal = new Counter(-9)
        let probe = (_x: int) => {
            let chs = [openCh, closedCh]
            let i: int = Async.SelectReceive(chs)
            closedIdx.Value = i
            closedVal.Value = Async.SelectValue()
            return 0
        }
        Async.FiberSpawn(probe, 0)
        Async.SchedulerRun()
        if (closedIdx.Value == 1 && closedVal.Value == 0) {
            Console.WriteLine("[PASS] SelectReceive reports closed-empty channel")
        } else {
            Console.WriteLine("[FAIL] select closed idx=" + String_FromInt(closedIdx.Value)
                + " val=" + String_FromInt(closedVal.Value))
        }

        // ── D. SelectTryReceive is non-blocking (from main) ─────
        let tryE1 = Async.ChannelNew(2)
        let tryE2 = Async.ChannelNew(2)
        let chsTry = [tryE1, tryE2]
        let tryNone: int = Async.SelectTryReceive(chsTry)   // both empty → -1
        Async.ChannelSend(tryE2, 55)                        // main, not full → buffers
        let trySome: int = Async.SelectTryReceive(chsTry)   // e2 ready → 1
        let trySomeVal: int = Async.SelectValue()
        if (tryNone == 0 - 1 && trySome == 1 && trySomeVal == 55) {
            Console.WriteLine("[PASS] SelectTryReceive non-blocking poll")
        } else {
            Console.WriteLine("[FAIL] select try none=" + String_FromInt(tryNone)
                + " some=" + String_FromInt(trySome)
                + " val=" + String_FromInt(trySomeVal))
        }

        // ── E. FiberCancel unparks a Select-parked fiber ────────
        let cg1 = Async.ChannelNew(1)
        let cg2 = Async.ChannelNew(1)
        let selCancelled = new Counter(-9)
        let selWorker = (_x: int) => {
            let chs = [cg1, cg2]
            let i: int = Async.SelectReceive(chs)   // both empty → parks
            selCancelled.Value = i                  // -1 after cancel
            return 0
        }
        let sf = Async.FiberSpawn(selWorker, 0)
        let canceller = (_x: int) => {
            Async.FiberSleep(10)
            Async.FiberCancel(sf)
            return 0
        }
        Async.FiberSpawn(canceller, 0)
        Async.SchedulerRun()
        if (selCancelled.Value == 0 - 1) {
            Console.WriteLine("[PASS] FiberCancel unparks a Select-parked fiber")
        } else {
            Console.WriteLine("[FAIL] select cancel result=" + String_FromInt(selCancelled.Value))
        }
    }
}
